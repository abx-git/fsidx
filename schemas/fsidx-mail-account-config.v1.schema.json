{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abx-git.github.io/fsidx/schemas/fsidx-mail-account-config.v1.schema.json",
  "title": "fsidx-mail-account-config-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "mailboxId", "transportMode", "updatedAt"],
  "properties": {
    "schema": { "const": "fsidx-mail-account-config-v1" },
    "version": { "const": 1 },
    "mailboxId": { "type": "string", "minLength": 1 },
    "transportMode": { "enum": ["import", "oauth", "imap_smtp"] },
    "defaultProvider": { "enum": ["google", "microsoft"] },
    "defaultFrom": { "type": "string" },
    "accountLabel": { "type": "string" },
    "googleClientId": { "type": "string" },
    "microsoftClientId": { "type": "string" },
    "loginUser": { "type": "string" },
    "imap": { "$ref": "#/$defs/mailEndpoint" },
    "smtp": { "$ref": "#/$defs/mailEndpoint" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "mailEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "security"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "security": { "enum": ["tls", "starttls", "plain"] }
      }
    }
  }
}