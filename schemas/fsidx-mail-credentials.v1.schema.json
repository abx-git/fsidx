{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abx-git.github.io/fsidx/schemas/fsidx-mail-credentials.v1.schema.json",
  "title": "fsidx-mail-credentials-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "mailboxId", "updatedAt"],
  "properties": {
    "schema": { "const": "fsidx-mail-credentials-v1" },
    "version": { "const": 1 },
    "mailboxId": { "type": "string", "minLength": 1 },
    "password": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}