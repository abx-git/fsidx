{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abx-git.github.io/fsidx/schemas/et2-tasks.v1.schema.json",
  "title": "ET2 tasks bundle (et2-tasks-v1)",
  "type": "object",
  "required": ["format", "version", "tasks"],
  "properties": {
    "format": { "const": "et2-tasks-v1" },
    "version": { "const": 1 },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "parentId": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["open", "in_progress", "done", "cancelled"]
          },
          "kind": { "type": "string", "enum": ["card", "note", "symbol"] },
          "order": { "type": "number" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "dueDate": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}