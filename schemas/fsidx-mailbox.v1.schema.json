{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fsidx-mailbox-v1.schema.json",
  "title": "fsidx-mailbox-v1",
  "type": "object",
  "required": ["schema", "version", "mailboxId", "vaultRoot"],
  "properties": {
    "schema": { "const": "fsidx-mailbox-v1" },
    "version": { "const": 1 },
    "mailboxId": { "type": "string", "format": "uuid" },
    "vaultRoot": { "type": "string" },
    "title": { "type": "string" },
    "transport": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["import", "oauth"] },
        "provider": { "enum": ["google", "microsoft"] },
        "accountHint": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}