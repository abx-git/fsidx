{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fsidx-email.v1.schema.json",
  "title": "fsidx-email-v1",
  "type": "object",
  "required": ["schema", "mailId", "headers", "state", "folder", "body", "tags"],
  "properties": {
    "schema": { "const": "fsidx-email-v1" },
    "mailId": { "type": "string" },
    "headers": {
      "type": "object",
      "required": ["from", "to", "subject", "date"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "cc": { "type": "string" },
        "subject": { "type": "string" },
        "date": { "type": "string" },
        "messageId": { "type": "string" }
      }
    },
    "state": {
      "enum": ["draft", "outbox", "sent", "received", "archived", "failed"]
    },
    "folder": {
      "enum": ["inbox", "outbox", "sent", "drafts", "trash"]
    },
    "body": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "html": { "type": "string" }
      }
    },
    "attachments": { "type": "array" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sync": { "type": "object" }
  }
}